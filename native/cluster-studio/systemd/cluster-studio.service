[Unit]
Description=Personal cluster layouts and guarded parked previews
RequiresMountsFor=/var/opt
After=local-fs.target cluster-render.service
[Service]
Type=simple
Group=tm_oap_app
RuntimeDirectory=cluster-studio
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/node /var/opt/cluster-studio/current/service.js
ExecStopPost=/usr/bin/node /var/opt/cluster-studio/current/media_firewall.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=3
KillMode=control-group
UMask=0027
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
